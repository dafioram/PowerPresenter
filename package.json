{
  "name": "presentation-editor",
  "version": "1.0.0",
  "description": "Local-first presentation editor that runs entirely in the browser",
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "build:viewer": "vite build --config vite.viewer.config.js",
    "prepare:assets": "npm run fonts && npm run build:viewer",
    "dev": "npm run prepare:assets && vite",
    "build": "npm run prepare:assets && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "npm run test:unit",
    "test:unit": "npm run fonts && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:unit && npm run build && npm run test:e2e",
    "test:e2e:xvfb": "xvfb-run -a playwright test --headed",
    "lint:schema": "node scripts/check-schema.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@fontsource-variable/noto-sans-kr": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "fflate": "^0.8.3",
    "immer": "^10.2.0",
    "preact": "^10.29.8",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.2",
    "prosemirror-view": "^1.42.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "ajv": "^8.20.0",
    "jsdom": "^25.0.1",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "private": true,
  "type": "module"
}
